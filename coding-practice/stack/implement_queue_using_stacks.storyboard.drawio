            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="c86" value="Why it works" style="text;html=1;align=center;verticalAlign=middle;fontSize=36;fontStyle=1;fontColor=#000000;" vertex="1" parent="1">
                    <mxGeometry x="40" y="90" width="1200" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="c87" value="1) A pour REVERSES order. Stack reverses once, a second stack reverses" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=0;fontColor=#000000;" vertex="1" parent="1">
                    <mxGeometry x="120" y="250" width="1040" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="c88" value="   again  →  two reversals = FIFO." style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=0;fontColor=#000000;" vertex="1" parent="1">
                    <mxGeometry x="120" y="300" width="1040" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="c89" value="2) Pour ONLY when out_stack is empty (lazy). Pour early → slow O(n)." style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=0;fontColor=#000000;" vertex="1" parent="1">
                    <mxGeometry x="120" y="380" width="1040" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="c90" value="3) Each element moves at most twice (in, then across) → amortized O(1)." style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=0;fontColor=#000000;" vertex="1" parent="1">
                    <mxGeometry x="120" y="460" width="1040" height="36" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
