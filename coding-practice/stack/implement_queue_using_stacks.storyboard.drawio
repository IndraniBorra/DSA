                    <mxGeometry x="120" y="395" width="1040" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="c96" value="Takeaway: reverse with a 2nd stack + defer work until needed." style="text;html=1;align=center;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#2d6a2d;" vertex="1" parent="1">
                    <mxGeometry x="40" y="540" width="1200" height="40" as="geometry"/>
